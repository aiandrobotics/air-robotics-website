---
import { AIR_BRAND } from '@air-robotics/docs-theme';
import '../styles/home.css';

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('color-scheme');
        if (stored === 'light' || stored === 'dark') {
          const meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) meta.setAttribute('content', stored);
        }
      } catch {}
    </script>
    <title>{AIR_BRAND.name} — {AIR_BRAND.fullName}</title>
    <meta
      name="description"
      content="Open-source robotics by Air Robotics. Unified documentation, 3D printable parts, electronics, and software."
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-mark" aria-label={`${AIR_BRAND.fullName} home`}>
          {AIR_BRAND.name}
        </a>

        <nav class="header-nav" aria-label="Primary navigation">
          <a href="#robots" class="nav-link">Robots</a>
          <a href="/docs/" class="nav-link">Docs</a>
        </nav>

        <div class="header-actions">
          <button
            type="button"
            id="theme-toggle"
            class="icon-btn theme-toggle"
            aria-label="Toggle color theme"
          >
            <span class="icon-sun" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2"></path>
                <path d="M12 20v2"></path>
                <path d="m4.93 4.93 1.41 1.41"></path>
                <path d="m17.66 17.66 1.41 1.41"></path>
                <path d="M2 12h2"></path>
                <path d="M20 12h2"></path>
                <path d="m6.34 17.66-1.41 1.41"></path>
                <path d="m19.07 4.93-1.41 1.41"></path>
              </svg>
              <span class="sr-only">Switch to light theme</span>
            </span>
            <span class="icon-moon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
              </svg>
              <span class="sr-only">Switch to dark theme</span>
            </span>
          </button>

          <a
            href={AIR_BRAND.githubOrgUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="Air Robotics on GitHub"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"></path>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-heading">
        <div class="container hero-inner">
          <div class="hero-eyebrow">{AIR_BRAND.fullName}</div>
          <h1 id="hero-heading" class="hero-title">
            Dream Big
            <br />
            Build Robots
            <span class="hero-gradient">Create Moonshots</span>
          </h1>
          <p class="hero-subtitle">
            From idea to reality. Complete documentation, source code, circuit diagrams,
            and 3D printable parts—brought together in one unified robotics hub.
          </p>
          <div class="hero-actions">
            <a href="/docs/" class="btn btn-primary">Explore Docs</a>
            <a href="#robots" class="btn btn-outline">Robots Coming Soon</a>
          </div>
        </div>
      </section>

      <section id="robots" class="robots-section" aria-labelledby="robots-heading">
        <div class="container">
          <div class="section-header">
            <p class="section-kicker">Robot Catalog</p>
            <h2 id="robots-heading" class="section-title">Robots Coming Soon</h2>
            <p class="section-description">
              Each robot lives in its own standalone repository and publishes automatically
              into this unified Air Robotics portal.
            </p>
          </div>

          <article class="robot-preview-card">
            <div class="robot-visual" aria-hidden="true">
              <div>
                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="12" x="3" y="8" rx="2"></rect>
                  <path d="M12 8V4H8"></path>
                  <path d="M2 14h2"></path>
                  <path d="M20 14h2"></path>
                  <path d="M15 13v2"></path>
                  <path d="M9 13v2"></path>
                </svg>
                <p class="robot-visual-label">First Robot</p>
              </div>
            </div>

            <div class="robot-details">
              <span class="status-pill">Coming Soon</span>
              <h3 class="robot-name">Fabrica</h3>
              <p class="robot-summary">
                Our first open-source robot project—complete with step-by-step assembly guides,
                3D printable parts, electronics schematics, and firmware documentation.
              </p>
              <a href="/docs/" class="btn btn-outline robot-link">Read Docs Preview</a>
            </div>
          </article>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <a href="/" class="brand-mark">{AIR_BRAND.name}</a>
          <p class="footer-copy">
            © {currentYear} {AIR_BRAND.fullName}. Building the future of open-source robotics.
          </p>
        </div>

        <nav class="footer-links" aria-label="Footer navigation">
          <a href="#robots" class="nav-link">Robots</a>
          <a href="/docs/" class="nav-link">Docs</a>
          <a
            href={AIR_BRAND.githubOrgUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link"
          >
            GitHub
          </a>
        </nav>
      </div>
    </footer>

    <script>
      const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
      const toggleButton = document.getElementById('theme-toggle');
      const media = window.matchMedia('(prefers-color-scheme: dark)');

      const getSystemScheme = (): 'light' | 'dark' => (media.matches ? 'dark' : 'light');

      const applyStoredScheme = (value: string | null) => {
        if (!meta) return;
        meta.content = value === 'light' || value === 'dark' ? value : 'light dark';
      };

      toggleButton?.addEventListener('click', () => {
        let stored: string | null = null;
        try {
          stored = localStorage.getItem('color-scheme');
        } catch {}

        const systemScheme = getSystemScheme();
        const currentScheme = stored === 'light' || stored === 'dark' ? stored : systemScheme;
        const targetScheme = currentScheme === 'dark' ? 'light' : 'dark';

        if (targetScheme === systemScheme) {
          try {
            localStorage.removeItem('color-scheme');
          } catch {}
          applyStoredScheme(null);
        } else {
          try {
            localStorage.setItem('color-scheme', targetScheme);
          } catch {}
          applyStoredScheme(targetScheme);
        }
      });

      window.addEventListener('storage', (event) => {
        if (event.key === 'color-scheme') {
          applyStoredScheme(event.newValue);
        }
      });
    </script>
  </body>
</html>
