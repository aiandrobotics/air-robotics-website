---
import { AIR_BRAND } from '@air-robotics/docs-theme';
import AirLayout from '@air-robotics/docs-theme/AirLayout.astro';
import { ROBOTS } from '../data/robots';

const featuredRobot = ROBOTS[0];

const capabilities = [
  {
    title: 'Complete Documentation',
    description:
      'Step-by-step assembly guides, calibration procedures, and troubleshooting notes in one unified docs portal.',
  },
  {
    title: '3D Printable Parts',
    description:
      'Downloadable CAD and STL files designed for standard FDM printers with clear print orientation and fit tolerances.',
  },
  {
    title: 'Open Source Code & Schematics',
    description:
      'Full firmware, control software, wiring diagrams, and bill of materials published openly on GitHub.',
  },
  {
    title: 'Standalone Robot Repos',
    description:
      'Every robot lives in its own independent repository so teams can develop and preview docs in isolation.',
  },
  {
    title: 'Unified Portal Experience',
    description:
      'All robot documentation shares one clean Air Robotics theme and builds automatically into air-robotics.ai.',
  },
  {
    title: 'Built to Scale',
    description:
      'Adding a new robot means registering its repository—new documentation flows through dev to prod automatically.',
  },
] as const;
---

<AirLayout
  title={`${AIR_BRAND.fullName} — Open-Source Robotics & Documentation`}
  description="From idea to reality. Complete documentation, source code, circuit diagrams, and 3D printable parts—brought together in one unified robotics hub."
  currentPath="/"
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="eyebrow">{AIR_BRAND.fullName}</div>
      <h1 class="hero-title">
        Dream Big
        <br />
        Build Robots
        <span class="hero-gradient">Create Moonshots</span>
      </h1>
      <p class="hero-subtitle">
        From idea to reality. Complete documentation, source code, circuit diagrams, and 3D
        printable parts—brought together in one unified robotics hub.
      </p>
      <div class="hero-actions">
        <a href="/robots/" class="btn btn-primary">Explore Robots</a>
        <a href="/docs/" class="btn btn-outline">Read Documentation</a>
      </div>
    </div>
  </section>

  {
    featuredRobot && (
      <section class="section section-surface">
        <div class="container">
          <div class="section-header">
            <p class="section-kicker">Featured Robot</p>
            <h2 class="section-title">Meet {featuredRobot.name}</h2>
            <p class="section-description">
              Each robot lives in its own standalone repository and publishes automatically into
              this unified Air Robotics portal.
            </p>
          </div>

          <article class="robot-spotlight">
            <div class="robot-visual" aria-hidden="true">
              <div>
                <svg
                  width="56"
                  height="56"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect width="18" height="12" x="3" y="8" rx="2" />
                  <path d="M12 8V4H8" />
                  <path d="M2 14h2" />
                  <path d="M20 14h2" />
                  <path d="M15 13v2" />
                  <path d="M9 13v2" />
                </svg>
                <p class="robot-visual-label">First Robot</p>
              </div>
            </div>

            <div class="robot-details">
              <span class="status-pill">{featuredRobot.status}</span>
              <h3 class="robot-name">{featuredRobot.name}</h3>
              <p class="card-text">{featuredRobot.summary}</p>
              <div class="robot-actions">
                <a href="/robots/" class="btn btn-primary">
                  View Catalog
                </a>
                <a href={featuredRobot.docsHref} class="btn btn-outline">
                  Docs Preview
                </a>
              </div>
            </div>
          </article>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="section-kicker">Built for Builders</p>
        <h2 class="section-title">Everything You Need to Build</h2>
        <p class="section-description">
          Comprehensive open-source resources so you can focus on building robots, not hunting for
          scattered instructions.
        </p>
      </div>

      <ul class="grid-3">
        {
          capabilities.map((item) => (
            <li class="card card-interactive">
              <div class="feature-icon" aria-hidden="true">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 2 2 7l10 5 10-5-10-5Z" />
                  <path d="m2 17 10 5 10-5" />
                  <path d="m2 12 10 5 10-5" />
                </svg>
              </div>
              <h3 class="card-title">{item.title}</h3>
              <p class="card-text">{item.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</AirLayout>
