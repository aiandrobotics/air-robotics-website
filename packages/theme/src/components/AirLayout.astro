---
import '../styles/tokens.css';
import AirFooter from './AirFooter.astro';
import AirHeader from './AirHeader.astro';

export interface Props {
  title: string;
  description: string;
  currentPath?: string;
}

const { title, description, currentPath = Astro.url.pathname } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('color-scheme');
        if (stored === 'light' || stored === 'dark') {
          const meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) meta.setAttribute('content', stored);
        }
      } catch {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <AirHeader currentPath={currentPath} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <AirFooter />

    <script>
      const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
      const toggleButton = document.getElementById('theme-toggle');
      const media = window.matchMedia('(prefers-color-scheme: dark)');

      const getSystemScheme = (): 'light' | 'dark' => (media.matches ? 'dark' : 'light');

      const applyStoredScheme = (value: string | null) => {
        if (!meta) return;
        meta.content = value === 'light' || value === 'dark' ? value : 'light dark';
      };

      toggleButton?.addEventListener('click', () => {
        let stored: string | null = null;
        try {
          stored = localStorage.getItem('color-scheme');
        } catch {}

        const systemScheme = getSystemScheme();
        const currentScheme = stored === 'light' || stored === 'dark' ? stored : systemScheme;
        const targetScheme = currentScheme === 'dark' ? 'light' : 'dark';

        if (targetScheme === systemScheme) {
          try {
            localStorage.removeItem('color-scheme');
          } catch {}
          applyStoredScheme(null);
        } else {
          try {
            localStorage.setItem('color-scheme', targetScheme);
          } catch {}
          applyStoredScheme(targetScheme);
        }
      });

      window.addEventListener('storage', (event) => {
        if (event.key === 'color-scheme') {
          applyStoredScheme(event.newValue);
        }
      });

      const menuButton = document.getElementById('mobile-menu-toggle');
      const mobileNav = document.getElementById('mobile-nav');

      const setMenuOpen = (open: boolean) => {
        if (!menuButton || !mobileNav) return;
        mobileNav.hidden = !open;
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };

      menuButton?.addEventListener('click', () => {
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        setMenuOpen(!isOpen);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mobileNav && !mobileNav.hidden) {
          setMenuOpen(false);
          menuButton?.focus();
        }
      });
    </script>
  </body>
</html>
