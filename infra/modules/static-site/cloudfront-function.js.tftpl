function handler(event) {
  var request = event.request;
  var uri = request.uri;
  var hostHeader = request.headers.host && request.headers.host.value;

  if (${enable_www_redirect} && hostHeader === 'www.${domain_name}') {
    var qs = Object.keys(request.querystring || {})
      .map(function (key) {
        var entry = request.querystring[key];
        return entry && entry.value ? key + '=' + entry.value : key;
      })
      .join('&');
    var location = 'https://${domain_name}' + uri + (qs ? '?' + qs : '');
    return {
      statusCode: 301,
      statusDescription: 'Moved Permanently',
      headers: {
        location: { value: location },
      },
    };
  }

  if (uri.endsWith('/')) {
    request.uri += 'index.html';
  } else if (!uri.includes('.')) {
    request.uri += '/index.html';
  }

  return request;
}
